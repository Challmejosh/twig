{% extends "dashboard_layout.twig" %}

{% block title %}View Ticket - TicketFlow{% endblock %}

{% block dashboard_content %}
<div class="p-6 w-full">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <h1 class="text-2xl font-bold">Ticket Details</h1>
    <div class="flex gap-2">
      {% if isEditing %}
      <a href="/tickets/{{ ticket.id }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
        Cancel Edit
      </a>
      {% else %}
      <a href="/tickets/{{ ticket.id }}?edit=true" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit Ticket
      </a>
      {% endif %}
      <button onclick="confirmDelete()" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
        Delete Ticket
      </button>
    </div>
  </div>

  {% if app.request.query.get('updated') %}
  <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded animate-fade-in">
    Ticket updated successfully!
  </div>
  {% endif %}

  <div class="bg-white shadow overflow-hidden sm:rounded-lg border border-slate-200">
    <form action="/tickets/{{ ticket.id }}" method="POST" class="divide-y divide-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="title" class="block text-sm font-medium text-gray-700">Title</label>
            {% if isEditing %}
            <input type="text" name="title" id="title" value="{{ ticket.title }}" required class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
            {% else %}
            <p class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-gray-50 rounded-md shadow-sm text-gray-900 sm:text-sm">{{ ticket.title }}</p>
            {% endif %}
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-gray-700">Status</label>
            {% if isEditing %}
            <select name="status" id="status" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
              <option value="open" {% if ticket.status == 'open' %}selected{% endif %}>Open</option>
              <option value="in-progress" {% if ticket.status == 'in-progress' %}selected{% endif %}>In Progress</option>
              <option value="closed" {% if ticket.status == 'closed' %}selected{% endif %}>Closed</option>
            </select>
            {% else %}
            <p class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-gray-50 rounded-md shadow-sm text-gray-900 sm:text-sm capitalize">{{ ticket.status }}</p>
            {% endif %}
          </div>
          <div>
            <label for="priority" class="block text-sm font-medium text-gray-700">Priority</label>
            {% if isEditing %}
            <select name="priority" id="priority" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
              <option value="low" {% if ticket.priority == 'low' %}selected{% endif %}>Low</option>
              <option value="medium" {% if ticket.priority == 'medium' %}selected{% endif %}>Medium</option>
              <option value="high" {% if ticket.priority == 'high' %}selected{% endif %}>High</option>
            </select>
            {% else %}
            <p class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-gray-50 rounded-md shadow-sm text-gray-900 sm:text-sm capitalize">{{ ticket.priority }}</p>
            {% endif %}
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Created At</label>
            <p class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-gray-50 rounded-md shadow-sm text-gray-900 sm:text-sm">{{ ticket.created_at }}</p>
          </div>
        </div>
        <div class="mt-6">
          <label for="desc" class="block text-sm font-medium text-gray-700">Description</label>
          {% if isEditing %}
          <textarea name="desc" id="desc" rows="4" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" required>{{ ticket.desc }}</textarea>
          {% else %}
          <p class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-gray-50 rounded-md shadow-sm text-gray-900 sm:text-sm">{{ ticket.desc }}</p>
          {% endif %}
        </div>
      </div>
      {% if isEditing %}
      <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
        <button type="submit" name="update" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          Update Ticket
        </button>
      </div>
      {% endif %}
    </form>
  </div>
</div>

<!-- Confirm Delete Modal -->
<div id="deleteModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3 text-center">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
        <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
        </svg>
      </div>
      <h3 class="text-lg leading-6 font-medium text-gray-900 mt-4">Delete Ticket</h3>
      <div class="mt-2 px-7 py-3">
        <p class="text-sm text-gray-500">
          Are you sure you want to delete this ticket? This action cannot be undone.
        </p>
      </div>
      <div class="flex items-center px-4 py-3">
        <button id="cancelDelete" class="px-4 py-2 bg-gray-300 text-gray-900 text-base font-medium rounded-md w-full mr-2">
          Cancel
        </button>
        <form action="/tickets/{{ ticket.id }}" method="POST" class="w-full ml-2">
          <button type="submit" name="delete" class="px-4 py-2 bg-red-600 text-white text-base font-medium rounded-md w-full">
            Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function confirmDelete() {
  document.getElementById('deleteModal').classList.remove('hidden');
}

document.getElementById('cancelDelete').addEventListener('click', function() {
  document.getElementById('deleteModal').classList.add('hidden');
});
</script>
{% endblock %}
